DATABASE_URL=sqlite:///./dev.db
# Optional in AWS Lambda: read DATABASE_URL from Secrets Manager instead.
# The secret can be a plain database URL string or JSON with DATABASE_URL/database_url.
DATABASE_SECRET_ARN=
DEBUG=True
AWS_REGION=ap-southeast-2
# Comma-separated allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
# Optional AWS S3 bucket name for artifact uploads
S3_BUCKET=
# Optional local storage directory for artifacts when S3 is not configured
LOCAL_STORAGE_DIR=storage
# Optional GitHub token for private repository parameter files
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_PARAMETER_PATH=
GITHUB_PARAMETER_PATH_TEMPLATE=resources/algorithms/{algorithm_code_lower}/algo_params.py
